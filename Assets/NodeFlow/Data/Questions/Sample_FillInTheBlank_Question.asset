  m_Name: Sample_FillInTheBlank_Question
  m_EditorClassIdentifier: 
  questionText: 'Chemical symbols: gold is _____, silver is _____, and iron is _____.'
  questionType: 4
  hints:
  - Gold and silver are in the same column as copper (Cu)
  - "Silver\u2019s symbol is the first two letters of its Latin name, argentum"
  - "Iron\u2019s symbol does not start with I \u2014 think of the Latin ferrum"
  showHintAfterAttempt: 1
  maxAttempts: 1
  points: 15
  explanation: Gold is Au (from Latin aurum), silver is Ag (from argentum), and iron
    is Fe (from ferrum).
  customUIPrefab: {fileID: 0}
  blanks:
  - correctAnswer: Au
    alternativeAnswers:
    - au
  - correctAnswer: Ag
    alternativeAnswers:
    - ag
  - correctAnswer: Fe
    alternativeAnswers:
    - fe
  correctAnswer: 
  alternativeAnswers: []
  caseSensitive: 0
  allowPartialMatch: 0
  partialMatchThreshold: 0.8
