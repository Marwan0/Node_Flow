/* Grid Background */
GridBackground {
    --grid-background-color: #282828;
    --line-color: rgba(193, 196, 192, 0.1);
    --thick-line-color: rgba(193, 196, 192, 0.1);
    --spacing: 15;
}

/* Node styling */
.node {
    min-width: 150px;
    margin: 0;
    padding: 0;
    /* Always have border to prevent shift on selection */
    border-width: 2px;
    border-color: rgba(0, 0, 0, 0);
    border-radius: 6px;
    /* Smooth transitions for all state changes (inspired by Doozy AnimBool lerps) */
    transition-property: border-color, opacity;
    transition-duration: 0.3s, 0.2s;
    transition-timing-function: ease-in-out, ease-in-out;
}

.node #title {
    background-color: #3C3C3C;
    height: 30px;
    padding-left: 10px;
    padding-right: 10px;
    /* Smooth title color transitions */
    transition-property: background-color;
    transition-duration: 0.35s;
    transition-timing-function: ease-in-out;
}

.node #title-label {
    color: #FFFFFF;
    font-size: 12px;
    -unity-font-style: bold;
}

.node #contents {
    background-color: #2D2D2D;
}

.node #input {
    background-color: #2D2D2D;
}

.node #output {
    background-color: #2D2D2D;
}

/* Port styling */
.port {
    height: 24px;
}

.port > #connector {
    border-color: #888888;
    background-color: #444444;
}

.port > #connector:hover {
    border-color: #FFFFFF;
}

/* Edge styling */
.edge {
    --edge-width: 2;
}

.edge:hover {
    --edge-width: 4;
}

/* Hover - subtle highlight */
.node:hover {
    border-color: rgba(100, 150, 200, 0.5);
}

/* Selection - prominent highlight (same width, different color) */
.node:selected {
    border-color: #44C0FF;
}

/* Selected AND hovered */
.node:selected:hover {
    border-color: #66D0FF;
}

/* ============================================================
   EXECUTION STATE STYLES (with smooth transitions)
   ============================================================ */

/* Idle state - default */
.node-idle {
    border-color: rgba(0, 0, 0, 0);
}

/* Running/Active state - ELECTRIC BLUE (catchy, unmissable) */
.node-running {
    border-color: #1E90FF !important;
    border-width: 3px;
}

.node-running #title {
    background-color: #1565C0 !important;
}

/* Completed state - GREEN (success) */
.node-completed {
    border-color: #4DB34D !important;
}

.node-completed #title {
    background-color: #267326 !important;
}

/* Failed state - RED (error) */
.node-failed {
    border-color: #FF4444 !important;
}

.node-failed #title {
    background-color: #B33333 !important;
}

/* State indicator bar (left side) */
#state-indicator {
    border-radius: 2px;
    transition-property: background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

/* Runtime dot */
#runtime-dot {
    transition-property: background-color;
    transition-duration: 0.3s;
    transition-timing-function: ease-in-out;
}

/* ============================================================
   NODE GLOW / PULSE EFFECT (inspired by Doozy Ping system)
   Big, obvious, electric-blue glow that makes the active node
   impossible to miss.
   ============================================================ */

#node-glow {
    position: absolute;
    left: -20px;
    top: -20px;
    right: -20px;
    bottom: -20px;
    border-radius: 18px;
    border-width: 4px;
    border-color: rgba(0, 0, 0, 0);
    background-color: rgba(0, 0, 0, 0);
    transition-property: background-color, border-color, opacity;
    transition-duration: 0.3s, 0.3s, 0.3s;
    transition-timing-function: ease-in-out, ease-in-out, ease-in-out;
}

/* Glow when running - bright electric blue, strong and unmissable */
.node-running #node-glow {
    background-color: rgba(30, 144, 255, 0.50);
    border-color: rgba(80, 200, 255, 0.85);
}

/* Glow when completed - same electric blue as running */
.node-completed #node-glow {
    background-color: rgba(30, 144, 255, 0.20);
    border-color: rgba(50, 180, 255, 0.4);
}

/* Glow when failed - same electric blue */
.node-failed #node-glow {
    background-color: rgba(30, 144, 255, 0.20);
    border-color: rgba(50, 180, 255, 0.4);
}

/* ============================================================
   EDGE RUNTIME HIGHLIGHTING (shows execution flow)
   ============================================================ */

.edge-active {
    --edge-color: #33CCFF;
    --edge-width: 3;
}

.edge-executed {
    --edge-color: #44DD55;
    --edge-width: 2;
}

/* ============================================================
   DELETE PREVIEW (Alt+Hover - inspired by Doozy delete mode)
   ============================================================ */

.node-delete-preview {
    border-color: rgba(255, 60, 60, 0.85) !important;
}

.node-delete-preview #title {
    background-color: rgba(180, 40, 40, 0.9) !important;
}

.node-delete-preview #node-glow {
    background-color: rgba(255, 40, 40, 0.15);
}

/* ============================================================
   ZOOM-BASED DETAIL HIDING (inspired by Doozy LOD thresholds)
   
   Conservative thresholds - nodes stay recognizable at all
   zoom levels. Title bar + color are NEVER hidden.
   
   LOD 1 (< 0.35): Hide inline content only
   LOD 2 (< 0.20): Also hide port labels and small indicators
   ============================================================ */

/* LOD 1: Only hide inline content (heavy UI) */
.zoom-lod-1 #inline-content {
    display: none;
}

/* LOD 2: Also hide port type labels and small indicators */
.zoom-lod-2 #inline-content {
    display: none;
}

.zoom-lod-2 .port > #type {
    display: none;
}

.zoom-lod-2 #runtime-dot {
    display: none;
}

.zoom-lod-2 #breakpoint-indicator {
    display: none;
}

/* LOD 2: compact ports but still visible */
.zoom-lod-2 .port {
    height: 18px;
}
